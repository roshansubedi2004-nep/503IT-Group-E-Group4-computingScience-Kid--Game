<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Defenders</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Exo+2:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="particles" id="particles"></div>

  <div class="game-layout-wrapper">

    <div class="game-container">
      <div class="screen active" id="screen-title">
        <div class="panel title-screen">
          <div class="panel-corner tl"></div><div class="panel-corner tr"></div>
          <div class="panel-corner bl"></div><div class="panel-corner br"></div>

          <div class="logo-svg">
            <svg viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg" width="160" height="176">
              <path d="M100 10 L175 45 L175 115 Q175 170 100 205 Q25 170 25 115 L25 45 Z" fill="#0d1e36" stroke="#111" stroke-width="7" stroke-linejoin="round"/>
              <path d="M100 24 L162 54 L162 115 Q162 160 100 191 Q38 160 38 115 L38 54 Z" fill="none" stroke="#2255cc" stroke-width="4" stroke-linejoin="round"/>
              <g transform="translate(78, 88)">
                <g id="gear-large">
                  <path d="M0,-38 L5,-30 L-5,-30 Z M0,38 L5,30 L-5,30 Z M-38,0 L-30,5 L-30,-5 Z M38,0 L30,5 L30,-5 Z M-27,-27 L-20,-18 L-18,-20 Z M27,-27 L20,-18 L18,-20 Z M-27,27 L-20,18 L-18,20 Z M27,27 L20,18 L18,20 Z" fill="#8899cc" stroke="none"/>
                  <circle r="34" fill="#8899cc"/>
                  <circle r="14" fill="#0d1e36"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(0)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(45)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(90)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(135)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(180)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(225)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(270)"/>
                  <rect x="-6" y="-42" width="12" height="14" rx="3" fill="#8899cc" transform="rotate(315)"/>
                  <circle r="15" fill="#0d1e36"/>
                </g>
              </g>
              <g transform="translate(128, 130)">
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(0)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(40)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(80)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(120)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(160)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(200)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(240)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(280)"/>
                <rect x="-5" y="-30" width="10" height="12" rx="2.5" fill="#cc3355" transform="rotate(320)"/>
                <circle r="24" fill="#cc3355"/>
                <circle r="10" fill="#0d1e36"/>
              </g>
            </svg>
          </div>
          
          <h1 class="game-title">PASSWORD<br>DEFENDERS</h1>
          
          <!-- NEW SEPARATE DESCRIPTION ELEMENT -->
          <p class="game-tagline" style="font-family: 'Share Tech Mono', monospace; color: var(--text-muted); font-size: 0.95rem; margin-top: 4px; margin-bottom: 20px; letter-spacing: 0.05em;">
            Cyber Quiz Game To Learn Password Safety
          </p>
          
          <div class="title-divider"></div>
          <button class="btn btn-primary" id="btn-to-rules">CLICK TO CONTINUE</button>
        </div>
      </div>

      <div class="screen" id="screen-rules">
        <div class="panel">
          <div class="panel-corner tl"></div><div class="panel-corner tr"></div>
          <div class="panel-corner bl"></div><div class="panel-corner br"></div>

          <h2 class="rules-title">RULES</h2>
          <p class="rules-subtitle">Please read the instructions before proceeding.</p>

          <div class="rule-item">
            <p class="rule-text"><strong>Choose one correct answer</strong> - Players get three options for each question — pick the correct one from the options.</p>
          </div>
          <div class="rule-item">
            <p class="rule-text"><strong>Correct answers earn +10 points</strong> and unlock the next lock and head to next level.</p>
          </div>
          <div class="rule-item">
            <p class="rule-text"><strong>Wrong answers earn no points</strong>, but you'll receive a <strong>security tip</strong> explaining strong and secure password feedback.</p>
          </div>
          <div class="rule-item">
            <p class="rule-text"><strong>You cannot skip questions.</strong> - every level must be answered to proceed.</p>
          </div>
          <div class="rule-item">
            <p class="rule-text"><strong>Complete all levels</strong> to crack the safe and earn your Password Defender badge!</p>
          </div>
          <div class="rule-item">
            <p class="rule-text"><strong>GOOD LUCK</strong></p>
          </div>

          <br>
          <div style="display:flex; gap:12px; justify-content:center;">
            <button class="btn btn-secondary" id="btn-back-to-title">← BACK</button>
            <button class="btn btn-primary" id="btn-deploy">DEPLOY →</button>
          </div>
        </div>
      </div>

      <div class="screen" id="screen-question">
        <div class="panel">
          <div class="panel-corner tl"></div><div class="panel-corner tr"></div>
          <div class="panel-corner bl"></div><div class="panel-corner br"></div>

          <div class="hud">
            <div class="hud-item">
              <span class="hud-label">Points</span>
              <span class="hud-value" id="hud-points">0</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">Level</span>
              <span class="hud-value" id="hud-level">1 / 8</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">Status</span>
              <span class="hud-value" style="color:var(--accent-green); font-size:0.8rem;">ACTIVE</span>
            </div>
          </div>

          <div class="lock-row" id="lock-row"></div>

          <p class="question-label">Level <span id="q-level-num">1</span> Password case scenario</p>
          <h2 class="question-text" id="q-context"></h2>
          <p class="question-hint">Hint: Choose the option that would relate to password security scenario the most.</p>

          <div class="options-grid" id="options-grid"></div>

          <div class="feedback-box" id="feedback-box">
            <div class="fb-title" id="fb-title"></div>
            <div id="fb-text"></div>
          </div>

          <div class="next-btn-row" id="next-btn-row" style="display:none;">
            <button class="btn btn-primary" id="next-btn">NEXT LEVEL →</button>
          </div>
        </div>
      </div>

      <div class="screen" id="screen-complete">
        <div class="panel complete-screen">
          <div class="panel-corner tl"></div><div class="panel-corner tr"></div>
          <div class="panel-corner bl"></div><div class="panel-corner br"></div>

          <div class="badge-standalone-display" id="final-badge-graphic">🏅</div>

          <h2 class="complete-title">YOU HAVE CRACKED<br>THE CODE!</h2>
          <p class="complete-sub">Outstanding work, Defender. The safe is open and the badge is yours. You've proven you know how to build a strong password defence.</p>

          <div class="final-score">
            <div class="score-stat">
              <div class="stat-val" id="final-points">0</div>
              <div class="stat-label">Points Earned</div>
            </div>
            <div class="score-stat">
              <div class="stat-val" id="final-correct">0</div>
              <div class="stat-label">Correct Answers</div>
            </div>
            <div class="score-stat">
              <div class="stat-val" id="final-badge">🏅</div>
              <div class="stat-label">Badge</div>
            </div>
          </div>

          <div class="btn-row">
            <button class="btn btn-green" id="btn-collect-badge">COLLECT BADGE ✓</button>
            <button class="btn btn-secondary" id="btn-play-again">PLAY AGAIN ↺</button>
          </div>
        </div>
      </div>

    </div>

    <div class="side-dashboard-panel" id="side-dashboard">
      <div class="side-panel-title">CAN YOU CRACK THE CODE?</div>
      
      <div class="vault-core-shield" id="vault-core">
        <div class="outer-tracker-ring"></div>
        <div class="inner-matrix-ring" id="inner-matrix">
          <div class="matrix-node"></div>
          <div class="matrix-node"></div>
          <div class="matrix-node"></div>
        </div>
        <div class="quantum-core-crystal"></div>
      </div>

      <div class="vault-terminal-readout">
        <div class="terminal-line">
          <span>Engine Link:</span>
          <span class="highlight" id="term-status" style="color:var(--accent-cyan)">CONNECTED</span>
        </div>
        <div class="terminal-line">
          <span>Progress:</span>
          <span class="highlight" id="term-pos">0°</span>
        </div>
        <div class="terminal-line">
          <span>Defense:</span>
          <span class="highlight" id="term-integrity" style="color:var(--accent-green)">100%</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Floating Action Button Menu (Bottom Right Corner) -->
  <div class="fab-wrapper" id="fab-wrapper">
    <div class="fab-menu">
      <!-- Share Icon (Network Node) -->
      <button class="fab-sub-btn" id="fab-share" title="Share Game">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A3 3 0 1 0 18 2A3 3 0 1 0 18 8Z"></path><path d="M6 15A3 3 0 1 0 6 9A3 3 0 1 0 6 15Z"></path><path d="M18 22A3 3 0 1 0 18 16A3 3 0 1 0 18 22Z"></path><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
      </button>
      <!-- Feedback Icon (Terminal Message Box) -->
      <button class="fab-sub-btn" id="fab-feedback" title="Give Feedback">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
      </button>
      <!-- Help Icon (Shield Question Mark) -->
      <button class="fab-sub-btn" id="fab-help" title="Help Guide">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </button>
    </div>

    <!-- Main Toggle Trigger Button (Updated to Hamburger Icon) -->
    <button class="fab-main-btn" id="fab-main-trigger" title="Open Menu">
      <svg class="fab-icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>
  </div>

  <script src="script.js"></script>
</body>
</html>
